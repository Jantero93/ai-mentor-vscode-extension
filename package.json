{
  "name": "ai-code-mentor",
  "displayName": "AI Code Mentor",
  "description": "AI mentor that challenges my coding decisions while I work",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "AI Code Mentor",
      "properties": {
        "ai-code-mentor.excludedModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Gpt-5.6-sol",
            "Claude Opus 4.7",
            "Claude Opus 4.8",
            "Claude Opus 5",
            "Gpt-5.5",
            "Gpt-6 Astra"
          ],
          "description": "Model names or IDs to hide from the AI Code Mentor model picker and exclude from automatic selection."
        }
      }
    },
    "commands": [
      {
        "command": "ai-code-mentor.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "ai-code-mentor.start",
        "title": "AI Code Mentor: Start"
      },
      {
        "command": "ai-code-mentor.selectModel",
        "title": "AI Code Mentor: Select Model"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
